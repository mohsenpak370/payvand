{
  "name": "payvand",
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm -C apps/web dev",
    "build": "pnpm -C apps/web build",
    "preview": "pnpm -C apps/web preview",
    "lint": "pnpm -C apps/web lint",
    "typecheck": "pnpm -C apps/web typecheck",
    "api": "cargo run --manifest-path apps/api/Cargo.toml --bin server",
    "anchor:build": "cd apps/contracts && anchor build && cp target/idl/payvand.json ../web/app/assets/payvand.idl.json",
    "anchor:deploy": "cd apps/contracts && anchor deploy",
    "anchor:keys": "cd apps/contracts && anchor keys list",
    "prepare": "husky"
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "apps/web/**/*.{vue,ts,js,mjs}": [
      "cd apps/web && corepack pnpm exec eslint --fix",
      "cd apps/web && corepack pnpm exec prettier --write"
    ],
    "apps/api/**/*.rs": [
      "sh -c 'cargo fmt --manifest-path apps/api/Cargo.toml'",
      "sh -c 'cargo clippy --manifest-path apps/api/Cargo.toml --quiet -- -D warnings'"
    ],
    "apps/contracts/**/*.rs": [
      "sh -c 'anchor fmt'",
      "sh -c 'cargo clippy --manifest-path apps/contracts/Cargo.toml --quiet -- -D warnings'"
    ]
  }
}
