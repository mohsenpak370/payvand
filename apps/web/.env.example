# Which Solana cluster the app targets: localnet, devnet, testnet or mainnet.
# The single switch for the whole app — Nuxt reads it when the config loads,
# the API reads it on startup. Restart `pnpm dev` / `pnpm api` after changing.
SOLANA_CLUSTER=devnet

# Origin of the Axum API. Leave empty in development: Nitro proxies /api to
# http://127.0.0.1:8787. Set it to the deployed API origin in production.
NUXT_PUBLIC_API_BASE=

# Optional custom RPC endpoint. Defaults to the public endpoint of
# SOLANA_CLUSTER (or http://127.0.0.1:8899 when it is localnet).
NUXT_PUBLIC_SOLANA_ENDPOINT=

# Address the Axum server binds to when run locally.
BIND_ADDR=127.0.0.1:8787

# Accounts and sessions. Leave unset in development to use an embedded
# SQLite file at data/payvand.db. In production point it at a libSQL server
# (Turso compatible) and set the matching auth token.
DATABASE_URL=
LIBSQL_AUTH_TOKEN=

# Optional: overrides the RPC endpoint the API reports in payment records.
SOLANA_RPC_URL=

# Password recovery emails. With EMAIL_HOST unset the API prints the reset
# link to its console instead of sending — the local default, mirroring
# Beacon's console email backend. Production: free Gmail SMTP
# (smtp.gmail.com, port 587, Gmail address + 16-char app password).
# FRONTEND_BASE_URL is where the emailed links point.
FRONTEND_BASE_URL=http://localhost:3000
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# Admin access: comma-separated addresses allowed to call /api/admin/* and
# open /admin. Unset means nobody has admin access.
ADMIN_EMAILS=
